      function setLanguage(lang) {
        const normalized = lang === "zh" ? "zh" : "en";
        const dict = translations[normalized] || {};
        document.documentElement.lang = normalized === "zh" ? "zh-CN" : "en";
        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          const value = dict[key];
          if (value) node.textContent = value;
          if (!value && normalized === "en" && node.dataset.i18nDefault) {
            node.textContent = node.dataset.i18nDefault;
          }
        });
        document.querySelectorAll("[data-i18n-default]").forEach((node) => {
          if (normalized === "en") node.textContent = node.getAttribute("data-i18n-default");
        });
        document.querySelectorAll("[data-language-toggle]").forEach((button) => {
          button.textContent = normalized === "zh" ? "EN" : "中文";
          button.setAttribute("aria-label", normalized === "zh" ? "Switch to English" : "切换到中文");
        });
        window.localStorage.setItem("lightesb-site-language", normalized);
      }

      document.querySelectorAll("[data-i18n]").forEach((node) => {
        node.setAttribute("data-i18n-default", node.textContent || "");
      });

      const initialLanguage = window.localStorage.getItem("lightesb-site-language") || "en";
      setLanguage(initialLanguage);

      document.querySelectorAll("[data-language-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const current = document.documentElement.lang === "zh-CN" ? "zh" : "en";
          setLanguage(current === "zh" ? "en" : "zh");
        });
      });
    </script>
