---
import "../styles/global.css";

const {
  title = "LightESB-Camel",
  description = "Lightweight integration runtime for legacy systems, industrial protocols, robotics workflows, and AI-assisted orchestration.",
  current = "",
  showReferral = true
} = Astro.props;

const siteUrl = "https://lightesb-camel.pages.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL("/images/lightesb-camel-hero.png", siteUrl).toString();

const navItems = [
  ["Capabilities", "/capabilities"],
  ["Architecture", "/architecture"],
  ["Robotics", "/robotics"],
  ["Examples", "/examples"],
  ["Articles", "/articles"],
  ["Docs", "/docs"]
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container nav">
          <div class="brand-area">
            <a class="brand" href="/" aria-label="LightESB-Camel home">
              <span class="brand-mark">L</span>
              <span>LightESB-Camel</span>
            </a>
            {showReferral && (
              <a class="partner-referral" href="mailto:nghxni@gmail.com" data-referral-email>
                <strong data-i18n="referral.reward">Introduce a signed deal — earn a 20% referral fee.</strong>
                <span data-i18n="referral.contact">Partner referrals: nghxni@gmail.com</span>
                <span data-i18n="referral.wechat">WeChat: nghxni</span>
              </a>
            )}
          </div>
          <nav class="nav-links" aria-label="Primary navigation">
            {navItems.map(([label, href]) => (
              <a href={href} aria-current={current === href ? "page" : undefined} data-i18n={`nav.${label.toLowerCase()}`}>{label}</a>
            ))}
            <button class="language-toggle" type="button" data-language-toggle aria-label="Switch language">中文</button>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <span data-i18n="footer.contact">LightESB-Camel delivery context. nghxni@gmail.com</span>
        </div>
      </footer>
