        "pricing.pro.5": "不自动续费——授权永久有效",
        "pricing.pro.cta": "邮件购买",
        "pricing.enterprise.name": "企业定制",
        "pricing.enterprise.price": "定制报价",
        "pricing.enterprise.term": "按项目单独报价",
        "pricing.enterprise.1": "多站点或定制部署支持",
        "pricing.enterprise.2": "定制协议与系统适配",
        "pricing.enterprise.3": "远程交付支持与培训",
