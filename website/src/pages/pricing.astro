---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";

const contact = "nghxni@gmail.com";
const trialMail = `mailto:${contact}?subject=${encodeURIComponent("LightESB trial request")}`;
const buyMail = `mailto:${contact}?subject=${encodeURIComponent("LightESB Pro purchase")}`;
const enterpriseMail = `mailto:${contact}?subject=${encodeURIComponent("LightESB Enterprise inquiry")}`;
---

<BaseLayout
  current="/pricing"
  title="LightESB-Camel Pricing and Licensing"
  description="LightESB-Camel pricing: 60-day free trial, Pro one-time license paid through Paddle with 12 months of updates and email support, and custom Enterprise delivery."
>
  <section>
    <div class="container">
      <SectionHead
        as="h1"
        eyebrow="Pricing"
        title="One tool, one license, no subscription"
        text="LightESB-Camel is an AI-assisted integration development tool delivered as a customized software package. Prices are in USD. Pro is a one-time payment — not a subscription, no auto-renewal."
        eyebrowKey="pricing.eyebrow"
        titleKey="pricing.title"
        textKey="pricing.text"
      />
      <div class="grid three">
        <article class="card plan">
          <h3 data-i18n="pricing.trial.name">Free Trial</h3>
          <p class="plan-price">$0</p>
          <p class="plan-term" data-i18n="pricing.trial.term">60-day evaluation</p>
          <ul class="list">
            <li data-i18n="pricing.trial.1">Full-featured delivery package with a generic trial watermark</li>
            <li data-i18n="pricing.trial.2">Expires automatically 60 days after the build date</li>
            <li data-i18n="pricing.trial.3">Documentation, examples, and CLI guides included</li>
            <li data-i18n="pricing.trial.4">Upgrade to Pro anytime — you receive a new customized build</li>
          </ul>
          <div class="action-row">
            <a class="button" href={trialMail} data-i18n="pricing.trial.cta">Request trial</a>
          </div>
        </article>
        <article class="card plan featured-doc">
          <h3 data-i18n="pricing.pro.name">Pro</h3>
          <p class="plan-price"><span class="strike">$500</span> $375</p>
          <p class="plan-term" data-i18n="pricing.pro.term">One-time payment · launch offer until Dec 31, 2026</p>
          <ul class="list">
            <li data-i18n="pricing.pro.1">Perpetual commercial license for one organization</li>
            <li data-i18n="pricing.pro.2">Customized build registered with your company name, contact person, and phone</li>
            <li data-i18n="pricing.pro.3">12 months of updates and email support from delivery</li>
            <li data-i18n="pricing.pro.4">Private download link delivered within 1-3 business days after completed payment and receipt of required information</li>
            <li data-i18n="pricing.pro.5">No auto-renewal — the license does not expire</li>
          </ul>
          <div class="action-row">
            <a class="button primary" href={buyMail} data-i18n="pricing.pro.cta">Contact to buy</a>
          </div>
        </article>
        <article class="card plan">
          <h3 data-i18n="pricing.enterprise.name">Enterprise</h3>
          <p class="plan-price" data-i18n="pricing.enterprise.price">Custom</p>
          <p class="plan-term" data-i18n="pricing.enterprise.term">Quoted per project</p>
          <ul class="list">
            <li data-i18n="pricing.enterprise.1">Multi-site or custom deployment support</li>
            <li data-i18n="pricing.enterprise.2">Custom protocol and system adaptation</li>
            <li data-i18n="pricing.enterprise.3">Remote delivery assistance and training</li>
            <li data-i18n="pricing.enterprise.4">Terms set by individual contract</li>
          </ul>
          <div class="action-row">
            <a class="button" href={enterpriseMail} data-i18n="pricing.enterprise.cta">Contact us</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <SectionHead
        eyebrow="How delivery works"
        title="Payment, packaging, download"
        text="Every paid package is built per customer. The flow is deliberately simple and manual for now."
        eyebrowKey="pricing.flow.eyebrow"
        titleKey="pricing.flow.title"
        textKey="pricing.flow.text"
      />
      <div class="grid two">
        <article class="card">
          <h3 data-i18n="pricing.flow.steps.title">What happens after you pay</h3>
          <ul class="list">
            <li data-i18n="pricing.flow.steps.1">You email your company name, contact person, phone number, and billing email.</li>
            <li data-i18n="pricing.flow.steps.2">After confirming the order details, we send a Paddle Checkout link in USD.</li>
            <li data-i18n="pricing.flow.steps.3">Once Paddle confirms the transaction as completed, we build and verify your customized package.</li>
            <li data-i18n="pricing.flow.steps.4">You receive a private download link within 1-3 business days after completed payment and receipt of all required information.</li>
          </ul>
        </article>
        <article class="card">
          <h3 data-i18n="pricing.flow.notes.title">Good to know</h3>
          <ul class="list">
            <li data-i18n="pricing.flow.notes.1">All prices are in USD. Pro is a one-time payment with no auto-renewal.</li>
            <li data-i18n="pricing.flow.notes.2">Full refund available any time before the download link is delivered — see the Refund Policy for post-delivery requests and Paddle support.</li>
            <li data-i18n="pricing.flow.notes.3">Purchases begin by email so we can confirm billing and build information before sending a Paddle Checkout link.</li>
          </ul>
          <div class="action-row">
            <a class="button" href="/terms" data-i18n="pricing.links.terms">Terms &amp; Conditions</a>
            <a class="button" href="/privacy" data-i18n="pricing.links.privacy">Privacy Policy</a>
            <a class="button" href="/refund" data-i18n="pricing.links.refund">Refund Policy</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    .plan {
      display: flex;
      flex-direction: column;
    }

    .plan .action-row {
      margin-top: auto;
      padding-top: 24px;
    }

    .plan-price {
      margin: 6px 0 2px;
      color: var(--text);
      font-size: 40px;
      font-weight: 760;
      line-height: 1.1;
    }

    .plan-price .strike {
      margin-right: 10px;
      color: var(--muted);
      font-size: 22px;
      font-weight: 600;
      text-decoration: line-through;
    }

    .plan-term {
      margin-bottom: 18px;
      color: var(--muted);
      font-size: 14px;
    }
  </style>

  <script is:inline>
    window.pageTranslations = {
      zh: {
        "pricing.eyebrow": "定价",
        "pricing.title": "一个工具，一次授权，没有订阅",
        "pricing.text": "LightESB-Camel 是 AI 辅助的集成开发工具，以定制化软件包形式交付。价格以美元计。Pro 为一次性付清——不是订阅，不会自动续费。",
        "pricing.trial.name": "免费试用",
        "pricing.trial.term": "60 天评估期",
        "pricing.trial.1": "完整功能交付包，内置通用试用指纹",
        "pricing.trial.2": "自构建之日起 60 天后自动到期",
