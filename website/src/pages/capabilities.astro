---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";

const repo = "https://github.com/nghxni/lightesb-camel/blob/main";
---

<BaseLayout current="/capabilities" title="Capabilities | LightESB-Camel">
  <section>
    <div class="container">
      <SectionHead
        eyebrow="Capability map"
        title="Integration capabilities packaged for delivery"
        text="LightESB-Camel organizes route runtime, reusable examples, operational APIs, and Agent-readable instructions around practical integration work."
      />
      <div class="grid three">
        <article class="card"><h3>HTTP route services</h3><p class="copy">Undertow ingress, internal HTTP forwarding, service package conventions, and route lifecycle guidance.</p></article>
        <article class="card"><h3>Data transformation</h3><p class="copy">ConditionalTransform, JsonTransform, DataSonnet, schema validation, charset processing, and stream cache guidance.</p></article>
        <article class="card"><h3>Security and governance</h3><p class="copy">IP, CIDR, token, regex permission checks, global exception handling, standard responses, logs, and diagnostics.</p></article>
        <article class="card"><h3>External systems</h3><p class="copy">ExternalDB, SAP NetWeaver, AVEVA Plant SCADA, HTTP forwarding, and enterprise integration examples.</p></article>
        <article class="card"><h3>Industrial protocols</h3><p class="copy">MQTT 5, OPC UA, Modbus/PLC gateway patterns, PLC4X evaluation paths, and field validation boundaries.</p></article>
        <article class="card"><h3>AI-assisted routes</h3><p class="copy">AI Agent + Tools components for orchestration, request construction, tool invocation, and operational workflows.</p></article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <SectionHead
        eyebrow="Operational surface"
        title="Built for repeatable validation"
        text="The package includes CLI and API guidance so teams can deploy, inspect, reload, diagnose, and rollback route services consistently."
      />
      <div class="grid two">
        <article class="card">
          <h3>Automation entry points</h3>
          <ul class="list">
            <li>Service start, stop, deploy, reload, and status checks.</li>
            <li>Diagnostics snapshots and warnings for runtime state.</li>
            <li>Deployment management and API response contracts.</li>
          </ul>
        </article>
        <article class="card">
          <h3>Documentation entry points</h3>
          <ul class="list">
            <li><a href="/docs">Documentation index</a> for components, CLI, APIs, and extensions.</li>
            <li><a href="/examples">Examples index</a> for runnable route packages.</li>
            <li><a href={`${repo}/docs/product-overview.md`}>Product overview</a> for delivery positioning and scope.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
