---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";

const repo = "https://github.com/nghxni/lightesb-camel/blob/main";
---

<BaseLayout current="/docs" title="Docs | LightESB-Camel">
  <section>
    <div class="container">
      <SectionHead
        eyebrow="Documentation"
        title="Read the delivery package in the same order an implementation team would"
        text="These links point to public delivery context files in the repository. They are written for route authors, operators, and external coding agents."
        eyebrowKey="docs.eyebrow"
        titleKey="docs.title"
        textKey="docs.text"
      />
      <div class="docs-list">
        <a class="docs-link" href={`${repo}/README.md`}><strong data-i18n="docs.repo.title">Repository README</strong><span data-i18n="docs.repo.text">Project positioning, delivery structure, support boundary, and quick start.</span></a>
        <a class="docs-link" href={`${repo}/docs/product-overview.md`}><strong data-i18n="docs.product.title">Product overview</strong><span data-i18n="docs.product.text">English capability map, audience, robotics boundary, and website deployment scope.</span></a>
        <a class="docs-link" href={`${repo}/docs/README.md`}><strong data-i18n="docs.index.title">Docs index</strong><span data-i18n="docs.index.text">Component, CLI, API, extension, experience, and example reading paths.</span></a>
        <a class="docs-link" href={`${repo}/docs/cli/README.md`}><strong data-i18n="docs.cli.title">CLI guide</strong><span data-i18n="docs.cli.text">Commands and automation paths for deployment, diagnostics, route operations, and robot workflows.</span></a>
        <a class="docs-link" href={`${repo}/docs/deployment-management-api.md`}><strong data-i18n="docs.deploy.title">Deployment management API</strong><span data-i18n="docs.deploy.text">Management API contracts for deployment and service operations.</span></a>
        <a class="docs-link" href={`${repo}/docs/runtime-diagnostics-api.md`}><strong data-i18n="docs.diagnostics.title">Runtime diagnostics API</strong><span data-i18n="docs.diagnostics.text">Diagnostics workflows, warnings, and runtime inspection guidance.</span></a>
        <a class="docs-link" href={`${repo}/docs/SOURCE_MAP.md`}><strong data-i18n="docs.source.title">Source map</strong><span data-i18n="docs.source.text">How public delivery documents are derived from internal source materials.</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
