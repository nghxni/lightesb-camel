---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";

const repo = "https://github.com/nghxni/lightesb-camel/blob/main";
---

<BaseLayout current="/examples" title="Examples | LightESB-Camel">
  <section>
    <div class="container">
      <SectionHead
        eyebrow="Runnable starting points"
        title="Copy an example, adapt configuration, verify behavior"
        text="The delivery repository includes route packages that can be copied into the runtime service directory and adjusted for POC or field validation."
      />
      <div class="docs-list">
        <a class="docs-link" href={`${repo}/example/README.md`}><strong>Example index</strong><span>Overview of runnable route examples and validation paths.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/http-undertow/DemoHttpSrv/v1.0.0/demo-http-route.xml`}><strong>HTTP route basics</strong><span>Minimal Undertow HTTP route service package.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/PlatformHttp/v3.0.0/platform-http-route.xml`}><strong>Platform HTTP</strong><span>HTTP orchestration and transformation examples.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/MysqlRouteSrv/v1.0.0/mysql-healthcheck-route.xml`}><strong>ExternalDB MySQL</strong><span>Database access and health check route example.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/AiAgentDemoSrv/v1.0.0/ai-agent-demo-route.xml`}><strong>AI Agent + Tools</strong><span>Agent-oriented orchestration route example.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/RobotMqttCommandSrv/v1.0.0/README.md`}><strong>Robot MQTT command</strong><span>Robot command route package and sample payloads.</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
