---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";

const repo = "https://github.com/nghxni/lightesb-camel/blob/main";
---

<BaseLayout current="/examples" title="Examples | LightESB-Camel">
  <section>
    <div class="container">
      <SectionHead
        eyebrow="Runnable starting points"
        title="Copy an example, adapt configuration, verify behavior"
        text="The delivery repository includes route packages that can be copied into the runtime service directory and adjusted for POC or field validation."
        eyebrowKey="examples.eyebrow"
        titleKey="examples.title"
        textKey="examples.text"
      />
      <div class="docs-list">
        <a class="docs-link" href={`${repo}/example/README.md`}><strong data-i18n="examples.index.title">Example index</strong><span data-i18n="examples.index.text">Overview of runnable route examples and validation paths.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/http-undertow/DemoHttpSrv/v1.0.0/demo-http-route.xml`}><strong data-i18n="examples.http.title">HTTP route basics</strong><span data-i18n="examples.http.text">Minimal Undertow HTTP route service package.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/PlatformHttp/v3.0.0/platform-http-route.xml`}><strong data-i18n="examples.platform.title">Platform HTTP</strong><span data-i18n="examples.platform.text">HTTP orchestration and transformation examples.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/MysqlRouteSrv/v1.0.0/mysql-healthcheck-route.xml`}><strong data-i18n="examples.mysql.title">ExternalDB MySQL</strong><span data-i18n="examples.mysql.text">Database access and health check route example.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/AiAgentDemoSrv/v1.0.0/ai-agent-demo-route.xml`}><strong data-i18n="examples.ai.title">AI Agent + Tools</strong><span data-i18n="examples.ai.text">Agent-oriented orchestration route example.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/RobotMqttCommandSrv/v1.0.0/README.md`}><strong data-i18n="examples.robot.title">Robot MQTT command</strong><span data-i18n="examples.robot.text">Robot command route package and sample payloads.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/TempApprovalMockSrv/v1.0.0/temp-approval-mock-route.xml`}><strong data-i18n="examples.tempform.title">Temporary approval form</strong><span data-i18n="examples.tempform.text">Route-served web form with a styled mock approval flow.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/RobotEdgeInferenceSrv/v1.0.0/README.md`}><strong data-i18n="examples.edge.title">Robot edge inference</strong><span data-i18n="examples.edge.text">Edge inference policy validation with a mock route package and decision sink.</span></a>
        <a class="docs-link" href={`${repo}/example/routes/RobotVda5050Srv/v1.0.0/README.md`}><strong data-i18n="examples.vda.title">VDA 5050 order contract</strong><span data-i18n="examples.vda.text">VDA 5050 order and instant action validation with config-template-only topics.</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
