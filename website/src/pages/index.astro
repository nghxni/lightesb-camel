---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductIntroHero from "../components/ProductIntroHero.astro";
import SectionHead from "../components/SectionHead.astro";
---

<BaseLayout
  current="/"
  title="LightESB-Camel | Connect existing systems without rewriting"
  description="LightESB connects existing applications, industrial devices, robots, and AI tools through a lightweight, governed integration runtime."
>
  <ProductIntroHero />

  <section class="band">
    <div class="container">
      <SectionHead
        eyebrow="Brand film"
        title="Tuoling in three minutes"
        text="Five real pain points, one platform. See how Tuoling connects legacy systems, industrial devices, robots, and AI tools into one governed flow."
        eyebrowKey="home.video.eyebrow"
        titleKey="home.video.title"
        textKey="home.video.text"
      />
      <div class="brand-video">
        <video
          controls
          preload="none"
          playsinline
          src="/videos/tuoling-brand-intro-en.mp4"
          poster="/videos/tuoling-brand-intro-en.jpg"
          data-brand-video
          data-video-zh="/videos/tuoling-brand-intro-zh.mp4"
          data-video-en="/videos/tuoling-brand-intro-en.mp4"
          data-poster-zh="/videos/tuoling-brand-intro-zh.jpg"
          data-poster-en="/videos/tuoling-brand-intro-en.jpg"
        ></video>
      </div>
    </div>
  </section>

  <div class="metric-strip">
    <div class="metric"><strong data-i18n="home.metric.hot.title">Keep what works</strong><span data-i18n="home.metric.hot.text">Connect existing software instead of forcing a full rewrite.</span></div>
    <div class="metric"><strong data-i18n="home.metric.field.title">Bridge the field</strong><span data-i18n="home.metric.field.text">Bring APIs, databases, industrial protocols, and robot workflows together.</span></div>
    <div class="metric"><strong data-i18n="home.metric.gov.title">Stay in control</strong><span data-i18n="home.metric.gov.text">Validate access, trace activity, diagnose issues, and manage delivery.</span></div>
    <div class="metric"><strong data-i18n="home.metric.agent.title">Start small</strong><span data-i18n="home.metric.agent.text">Use a working example for one integration, then reuse the pattern.</span></div>
  </div>

  <section>
    <div class="container">
      <SectionHead
        eyebrow="Why it exists"
        title="Modernize integration without rewriting core systems"
        text="LightESB-Camel helps teams wrap existing systems with route services, protocol adapters, validation, logging, and operational controls. It is small enough for private or edge deployment and structured enough for repeatable POC and delivery work."
        eyebrowKey="home.why.eyebrow"
        titleKey="home.why.title"
        textKey="home.why.text"
      />
      <div class="grid three">
        <article class="card">
          <span class="tag" data-i18n="home.legacy.tag">Legacy systems</span>
          <h3 data-i18n="home.legacy.title">Connect what already runs</h3>
          <p class="copy" data-i18n="home.legacy.text">Expose or consume HTTP APIs, databases, message flows, ERP interfaces, and internal services through Camel XML routes and configuration.</p>
        </article>
        <article class="card">
          <span class="tag" data-i18n="home.industrial.tag">Industrial protocols</span>
          <h3 data-i18n="home.industrial.title">Bridge field systems</h3>
          <p class="copy" data-i18n="home.industrial.text">Use examples and documentation for OPC UA, MQTT 5, Modbus/PLC paths, AVEVA Plant SCADA, SAP NetWeaver, and ExternalDB access.</p>
        </article>
        <article class="card">
          <span class="tag" data-i18n="home.robot.tag">Robotics and AI</span>
          <h3 data-i18n="home.robot.title">Govern high-level orchestration</h3>
          <p class="copy" data-i18n="home.robot.text">Coordinate task intake, telemetry normalization, command validation, audit events, and AI Agent + Tools workflows outside hard real-time control loops.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <SectionHead
        eyebrow="Delivery model"
        title="A public repository that can be read, copied, and validated"
        text="The delivery context contains runtime files, documentation, examples, skills, and this static website. The source repository remains the editing authority; the public delivery repository is generated by sync scripts."
        eyebrowKey="home.delivery.eyebrow"
        titleKey="home.delivery.title"
        textKey="home.delivery.text"
      />
      <div class="flow">
        <div class="flow-step"><span class="tag">1</span><h3 data-i18n="home.step1.title">Pick an example</h3><p class="copy" data-i18n="home.step1.text">Start from example/routes and choose the closest integration pattern.</p></div>
        <div class="flow-step"><span class="tag">2</span><h3 data-i18n="home.step2.title">Adapt config</h3><p class="copy" data-i18n="home.step2.text">Set service properties, endpoints, protocol targets, and validation rules.</p></div>
        <div class="flow-step"><span class="tag">3</span><h3 data-i18n="home.step3.title">Load route</h3><p class="copy" data-i18n="home.step3.text">Deploy the service package and use hot loading where the runtime boundary allows it.</p></div>
        <div class="flow-step"><span class="tag">4</span><h3 data-i18n="home.step4.title">Verify behavior</h3><p class="copy" data-i18n="home.step4.text">Use curl, CLI commands, diagnostics, and service logs to prove the route works.</p></div>
        <div class="flow-step"><span class="tag">5</span><h3 data-i18n="home.step5.title">Operate safely</h3><p class="copy" data-i18n="home.step5.text">Use deployment APIs, audit patterns, and rollback guidance for controlled delivery.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
